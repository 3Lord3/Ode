# Genius client token embedded into the binary at build time (see build.rs).
# Copy this file to .env and set the value. .env itself is not committed.
#
# An alternative is an environment variable at build time:
#   GENIUS_ACCESS_TOKEN=... cargo build --release
#
# Without a token the app still builds and runs, but every request to the API
# fails with an error and the search page shows a "No access token" message.

GENIUS_ACCESS_TOKEN=